<Project Sdk="Microsoft.NET.Sdk">

  <!-- =================================================================
       BannerlordInspector - a read-only window into a running campaign.

       Serves JSON over loopback so an external tool (the MCP bridge in
       ..\mcp) can ask the live game questions that static analysis
       cannot answer.

       Source lives here, outside the game. Build output goes to dist\;
       deployment into Modules\ is opt-in:
         dotnet build BannerlordInspector.csproj -c Release -p:Deploy=true
       ================================================================= -->

  <PropertyGroup>
    <AssemblyName>BannerlordInspector</AssemblyName>
    <RootNamespace>BannerlordInspector</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>

    <!-- Read only, for reference assemblies. Never written to by a plain build. -->
    <GameFolder Condition="'$(BANNERLORD_GAME_DIR)' != ''">$(BANNERLORD_GAME_DIR)</GameFolder>
    <GameFolder Condition="'$(BANNERLORD_GAME_DIR)' == ''">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>

    <OutputPath>$(MSBuildProjectDirectory)\dist\bin\Win64_Shipping_Client\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- =================================================================
       Where HarmonyLib lives depends on the install, and getting this
       wrong is not a subtle failure - it is CS0246 on every file that
       mentions Harmony.

         - vanilla-ish install: the Bannerlord.Harmony module owns it
         - TAOM install: Bannerlord.Harmony is an EMPTY STUB (no bin\ at
           all) and TAOM.Dependencies ships 0Harmony 2.4.2 instead
         - this machine also keeps an archived modlist under
           Modules\TOR MODS\ with its own copy

       Compile against whichever is actually present, in the order the
       runtime would resolve it, and say so out loud - a build that
       silently picked a different Harmony than the one that will be
       loaded is exactly the mismatch this is meant to prevent.
       ================================================================= -->
  <PropertyGroup>
    <_HarmonyStd>$(GameFolder)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</_HarmonyStd>
    <_HarmonyTaom>$(GameFolder)\Modules\TAOM.Dependencies\bin\Win64_Shipping_Client\0Harmony.dll</_HarmonyTaom>
    <_HarmonyArchive>$(GameFolder)\Modules\TOR MODS\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</_HarmonyArchive>

    <HarmonyPath Condition="Exists('$(_HarmonyStd)')">$(_HarmonyStd)</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' AND Exists('$(_HarmonyTaom)')">$(_HarmonyTaom)</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' AND Exists('$(_HarmonyArchive)')">$(_HarmonyArchive)</HarmonyPath>
  </PropertyGroup>

  <Target Name="ReportHarmonySource" BeforeTargets="ResolveReferences">
    <Error Condition="'$(HarmonyPath)' == ''"
           Text="No 0Harmony.dll found under $(GameFolder)\Modules. Looked in Bannerlord.Harmony, TAOM.Dependencies and 'TOR MODS\Bannerlord.Harmony'. Install a module that ships Harmony, or set BANNERLORD_GAME_DIR to an install that has one." />
    <Message Importance="high" Text="Harmony: $(HarmonyPath)" />
  </Target>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <Compile Remove="dist\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework assemblies, not game ones. Crash bundles are zips, and opening one from inside
         the running game is the whole point of /crashes - the alternative is alt-tabbing to a
         folder and picking through an archive by hand, every time. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <Target Name="StageModule" AfterTargets="Build">
    <Copy SourceFiles="SubModule.xml" DestinationFolder="$(MSBuildProjectDirectory)\dist\" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Staged at $(MSBuildProjectDirectory)\dist\ (not deployed)" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="StageModule" Condition="'$(Deploy)' == 'true'">
    <ItemGroup>
      <StagedFiles Include="$(MSBuildProjectDirectory)\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(StagedFiles)"
          DestinationFiles="@(StagedFiles->'$(GameFolder)\Modules\BannerlordInspector\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="DEPLOYED to $(GameFolder)\Modules\BannerlordInspector\" />
  </Target>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.*.dll" Exclude="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Native.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Absent in a total-conversion install; a wildcard that matches nothing is not an error. -->
    <Reference Include="$(GameFolder)\Modules\StoryMode\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\CustomBattle\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
